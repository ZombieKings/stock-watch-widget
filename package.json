{
  "name": "stock-watch-widget",
  "version": "1.0.0",
  "description": "A股行情+当日新闻桌面悬浮小窗",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test src/*.test.js renderer/*.test.js",
    "icon": "electron build/make-icon.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.local.stock-watch-widget",
    "productName": "StockWatchWidget",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*.js",
      "!src/**/*.test.js",
      "renderer/**/*",
      "!renderer/**/*.test.js",
      "assets/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable",
        "nsis"
      ]
    },
    "portable": {
      "artifactName": "StockWatchWidget-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stock Watch Widget"
    }
  }
}
